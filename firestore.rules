rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Administradores: um documento admins/{uid} por cada conta com acesso ao backoffice.
    // Criar manualmente na consola do Firebase.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Contas bloqueadas: um documento bloqueados/{uid} (criado no backoffice → Contas).
    function blocked() {
      return exists(/databases/$(database)/documents/bloqueados/$(request.auth.uid));
    }

    // Cliente com sessão iniciada e conta não bloqueada
    function active() {
      return signedIn() && !blocked();
    }

    match /bloqueados/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Catálogo: só clientes com sessão iniciada.
    // Para tornar o catálogo público, trocar "signedIn()" por "true" nas duas regras de leitura abaixo.
    match /products/{id} {
      allow read: if active() || isAdmin();
      allow write: if isAdmin();
    }

    // Índice do catálogo (publicado pelo backoffice; a loja lê só isto em vez de todos os artigos)
    match /catalog/{id} {
      allow read: if active() || isAdmin();
      allow write: if isAdmin();
    }

    match /catalogIndex/{id} {
      allow read: if active() || isAdmin();
      allow write: if isAdmin();
    }

    match /patches/{id} {
      allow read: if active() || isAdmin();
      allow write: if isAdmin();
    }

    // Perfil do cliente (nome, telefone, morada)
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if active() && request.auth.uid == uid;
    }

    match /orders/{id} {
      allow create: if active()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.createdAt == request.time
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.keys().hasOnly(['uid', 'email', 'customer', 'items', 'notes', 'status', 'createdAt']);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
