rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Administradores: um documento admins/{uid} por cada conta com acesso ao backoffice.
    // Criar manualmente na consola do Firebase.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Contas bloqueadas: um documento bloqueados/{uid} (criado no backoffice → Contas).
    function blocked() {
      return exists(/databases/$(database)/documents/bloqueados/$(request.auth.uid));
    }

    // Contas aprovadas: um documento aprovados/{uid} (criado no backoffice → Contas → Aprovar).
    function approved() {
      return exists(/databases/$(database)/documents/aprovados/$(request.auth.uid));
    }

    // Cliente com sessão iniciada, conta aprovada (ou administrador) e não bloqueada
    function active() {
      return signedIn() && (approved() || isAdmin()) && !blocked();
    }

    // Definições do backoffice (ex.: preços base)
    match /config/{id} {
      allow read, write: if isAdmin();
    }

    match /aprovados/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Emails enviados pela extensão "Trigger Email".
    // O backoffice cria qualquer pedido; o cliente só pode pedir o email "encomenda recebida"
    // de uma encomenda sua, para o próprio email, uma vez (o id é encomenda-<id da encomenda>).
    match /mail/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (
        active()
        && id.matches('encomenda-[A-Za-z0-9]+')
        && request.resource.data.keys().hasOnly(['to', 'message', 'tipo', 'encomenda', 'criadoEm'])
        && request.resource.data.to == request.auth.token.email
        && request.resource.data.tipo == 'encomenda-recebida'
        && request.resource.data.encomenda == id.split('-')[1]
        && request.resource.data.message.keys().hasOnly(['subject', 'text', 'html'])
        && get(/databases/$(database)/documents/orders/$(id.split('-')[1])).data.uid == request.auth.uid
      );
    }

    match /bloqueados/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Catálogo: só clientes com sessão iniciada.
    // Para tornar o catálogo público, trocar "signedIn()" por "true" nas duas regras de leitura abaixo.
    match /products/{id} {
      allow read: if active() || isAdmin();
      allow write: if isAdmin();
    }

    // Índice do catálogo (publicado pelo backoffice; a loja lê só isto em vez de todos os artigos)
    match /catalog/{id} {
      allow read: if active() || isAdmin();
      allow write: if isAdmin();
    }

    match /catalogIndex/{id} {
      allow read: if active() || isAdmin();
      allow write: if isAdmin();
    }

    match /patches/{id} {
      allow read: if active() || isAdmin();
      allow write: if isAdmin();
    }

    // Perfil do cliente (nome, telefone, morada)
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      // o perfil é criado no registo, ainda antes de a conta ser aprovada
      allow write: if signedIn() && request.auth.uid == uid && !blocked();
    }

    match /orders/{id} {
      allow create: if active()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.createdAt == request.time
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.keys().hasOnly(['uid', 'email', 'customer', 'items', 'notes', 'status', 'createdAt']);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
